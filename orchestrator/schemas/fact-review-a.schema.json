{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-code-course.local/schemas/fact-review-a.schema.json",
  "title": "Fact Review Stage A — Independent Blind Review Result",
  "description": "Schema for the DeepSeek independent fact review (Stage A) output. The reviewer does NOT see Codex conclusions.",
  "type": "object",
  "required": [
    "schema_version",
    "review_type",
    "unit_id",
    "attempt",
    "status",
    "independent_findings",
    "mechanism_summary",
    "risks",
    "unconfirmed"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Schema version for forward compatibility.",
      "examples": ["1.0"]
    },
    "review_type": {
      "type": "string",
      "const": "fact-review-a",
      "description": "Fixed identifier for this review type."
    },
    "unit_id": {
      "type": "string",
      "description": "Unit identifier being reviewed, e.g. M03.",
      "pattern": "^M\\d{2}$"
    },
    "attempt": {
      "type": "integer",
      "description": "Attempt number (1-based).",
      "minimum": 1,
      "maximum": 3
    },
    "status": {
      "type": "string",
      "enum": ["complete", "incomplete_need_supplement", "inconclusive"],
      "description": "Review status: complete (all claims analyzed), incomplete_need_supplement (more evidence needed), inconclusive (cannot reach conclusions even with more evidence)."
    },
    "independent_findings": {
      "type": "array",
      "description": "Independent analysis findings, one per key mechanism or code path examined.",
      "items": {
        "type": "object",
        "required": ["finding_id", "subject", "analysis", "confidence"],
        "properties": {
          "finding_id": {
            "type": "string",
            "description": "Unique identifier for this finding."
          },
          "subject": {
            "type": "string",
            "description": "The function, class, module, or mechanism being analyzed."
          },
          "analysis": {
            "type": "object",
            "description": "Independent analysis details.",
            "properties": {
              "entry_points": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Entry function signatures or paths."
              },
              "exit_points": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Return types, thrown exceptions, or side effects."
              },
              "call_chain": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Ordered list of calls in the main path."
              },
              "control_flow": {
                "type": "string",
                "description": "Summary of branches, loops, and implicit control flow."
              },
              "data_flow": {
                "type": "string",
                "description": "How data moves through the mechanism."
              },
              "state_ownership": {
                "type": "string",
                "description": "Who creates, owns, modifies, and destroys state."
              },
              "concurrency": {
                "type": "string",
                "description": "Async patterns, race conditions, cancellation propagation."
              },
              "error_handling": {
                "type": "string",
                "description": "Exception paths, recovery, fallback behavior."
              }
            }
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"],
            "description": "Confidence in this analysis based on evidence completeness."
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file", "symbol"],
              "properties": {
                "file": { "type": "string" },
                "symbol": { "type": "string" },
                "lines": { "type": "string" }
              }
            },
            "description": "Source locations that support this analysis."
          }
        }
      }
    },
    "mechanism_summary": {
      "type": "string",
      "description": "One paragraph summary of the overall mechanism as understood from independent analysis."
    },
    "risks": {
      "type": "array",
      "description": "Risks identified during independent analysis.",
      "items": {
        "type": "object",
        "required": ["risk_id", "category", "description", "severity"],
        "properties": {
          "risk_id": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["concurrency", "state_corruption", "security", "data_loss", "undefined_behavior", "version_sensitivity", "other"]
          },
          "description": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "affected_symbols": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "unconfirmed": {
      "type": "array",
      "description": "Aspects that could not be confirmed from the provided evidence.",
      "items": {
        "type": "object",
        "required": ["item_id", "question", "reason"],
        "properties": {
          "item_id": { "type": "string" },
          "question": { "type": "string" },
          "reason": { "type": "string" },
          "what_would_confirm": { "type": "string" }
        }
      }
    },
    "supplement_request": {
      "type": "object",
      "description": "If status is incomplete_need_supplement, a single request for additional evidence.",
      "required": ["path", "symbol", "reason", "target_conclusion"],
      "properties": {
        "path": { "type": "string", "description": "File path relative to source-snapshot/." },
        "symbol": { "type": "string", "description": "Specific function/class/interface name." },
        "reason": { "type": "string", "description": "Why current evidence is insufficient." },
        "target_conclusion": { "type": "string", "description": "What conclusion the supplement would help confirm or rule out." }
      }
    }
  },
  "additionalProperties": false
}
